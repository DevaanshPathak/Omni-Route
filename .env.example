# Phase 3 server-only OpenAI-compatible Responses API configuration.
# Leave all three blank to use the deterministic fixture provider in auto mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=

# Docker Compose host ports.
API_PORT=4100
WEB_PORT=3000

# Used by the Next.js server during local development.
INTERNAL_API_URL=http://localhost:4100
