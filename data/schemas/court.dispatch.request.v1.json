{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "court.dispatch.request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["property_ref", "beneficiary", "decree_status"],
  "properties": {
    "property_ref": { "type": "string", "minLength": 1 },
    "beneficiary": { "type": "string", "minLength": 1 },
    "decree_status": { "const": "DISPATCHED" }
  }
}
